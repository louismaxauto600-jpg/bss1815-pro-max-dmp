/* =========================================================
   CENTRAL AI FORM
   ========================================================= */

function initializeAIForm() {

  const form = document.querySelector(
    "#ai-form, [data-ai-form]"
  );

  if (!form) {
    return;
  }

  const promptInput = form.querySelector(
    "#ai-prompt, [name='prompt'], [data-ai-prompt]"
  );

  const submitButton = form.querySelector(
    "button[type='submit'], [data-ai-submit]"
  );

  form.addEventListener(
    "submit",
    async (event) => {

      event.preventDefault();

      if (aiRequestInProgress) {
        return;
      }

      const prompt =
        promptInput?.value.trim() || "";

      if (!prompt) {

        showAIMessage(
          getAIText(
            "Tanpri ekri sa ou bezwen AI a fè.",
            "Veuillez écrire ce que vous souhaitez que l’IA fasse.",
            "Please write what you want the AI to do."
          ),
          "error"
        );

        promptInput?.focus();

        return;
      }

      setAIButtonLoading(
        submitButton,
        true
      );

      setAIStatus("processing");

      try {

        const request =
          createAIRequest(prompt);

        const response =
          await sendAIRequest(request);

        displayAIResponse(response);

        saveAIHistoryItem(
          request,
          response
        );

        setAIStatus("success");

        showAIMessage(
          getAIText(
            "AI a fini prepare repons lan.",
            "L’IA a terminé la réponse.",
            "The AI response is ready."
          ),
          "success"
        );

      } catch (error) {

        console.error(
          "Central AI request error:",
          error.message
        );

        setAIStatus("error");

        showAIMessage(
          getAIErrorMessage(error),
          "error"
        );

      } finally {

        setAIButtonLoading(
          submitButton,
          false
        );

      }
    }
  );

  updateAIPromptPlaceholder();
}

/* =========================================================
   CREATE AI REQUEST
   ========================================================= */

function createAIRequest(prompt) {

  const projectId = getActiveAIProject();

  const language = getAILanguage();

  return {

    id: createAIRequestId(),

    tool: activeAITool,

    project: projectId,

    language,

    context:
      AI_PROJECT_CONTEXTS[projectId]?.[language] ||
      AI_PROJECT_CONTEXTS[projectId]?.ht ||
      "",

    prompt: String(prompt || "").trim(),

    user: null,

    createdAt: new Date().toISOString()

  };
}

/* =========================================================
   CENTRAL OPENAI API CONNECTION
   EXISTING NETLIFY BACKEND
   ========================================================= */

async function sendAIRequest(request) {

  aiRequestInProgress = true;

  const controller = new AbortController();

  const timeout = setTimeout(
    () => controller.abort(),
    45000
  );

  try {

    if (
      !request ||
      typeof request.prompt !== "string" ||
      !request.prompt.trim()
    ) {
      throw new Error("ai/message-required");
    }

    if (request.prompt.length > 12000) {
      throw new Error("ai/message-too-long");
    }

    const projectId = Object.hasOwn(
      PRO_MAX_AI_CENTER.projects,
      request.project
    )
      ? request.project
      : "bss1815";

    const project =
      PRO_MAX_AI_CENTER.projects[projectId];

    const language = normalizeAILanguage(
      request.language
    );

    const tool = getAITool(request.tool)
      ? request.tool
      : "assistant";

    const context =
      AI_PROJECT_CONTEXTS[projectId]?.[language] ||
      AI_PROJECT_CONTEXTS[projectId]?.ht ||
      "";

    const message = [

      "BSS1815 PRO-MAX DMP CENTRAL AI CENTER",

      `Active project: ${project.name}`,

      `Project context: ${context}`,

      `Active AI tool: ${tool}`,

      "Do not claim access to unavailable systems or data.",

      "Do not claim that audio, video or images were generated when only text was prepared.",

      "User request:",

      request.prompt.trim()

    ].join("\n\n");

    const response = await fetch(

      PRO_MAX_AI_CENTER.endpoint,

      {

        method: "POST",

        headers: {
          "Content-Type": "application/json"
        },

        body: JSON.stringify({

          message,

          mode: tool,

          language

        }),

        signal: controller.signal

      }
    );

    if (!response.ok) {

      throw new Error(
        `ai/http-${response.status}`
      );

    }

    const data = await response.json();

    const content =
      data.answer ||
      data.content ||
      data.reply ||
      data.response ||
      data.message ||
      data.text ||
      "";

    if (
      typeof content !== "string" ||
      !content.trim()
    ) {

      throw new Error(
        "ai/empty-response"
      );

    }

    if (data.success === false) {

      throw new Error(
        "ai/backend-error"
      );

    }

    return {

      id: data.id || request.id,

      content: content.trim(),

      provider: "OpenAI",

      project: projectId,

      tool,

      language,

      createdAt:
        data.createdAt ||
        new Date().toISOString()

    };

  } finally {

    clearTimeout(timeout);

    aiRequestInProgress = false;

  }
}

/* =========================================================
   DISPLAY AI RESPONSE
   ========================================================= */

function displayAIResponse(response) {

  const output = document.querySelector(
    "#ai-response, [data-ai-response]"
  );

  if (!output) {
    return;
  }

  output.hidden = false;

  if (
    output.tagName === "TEXTAREA" ||
    output.tagName === "INPUT"
  ) {

    output.value = response.content;

  } else {

    output.textContent = response.content;

  }

  document
    .querySelectorAll("[data-ai-provider]")
    .forEach((element) => {

      element.textContent =
        response.provider || "PRO-MAX AI";

    });

  document
    .querySelectorAll("[data-ai-response-date]")
    .forEach((element) => {

      element.textContent =
        formatAIDate(response.createdAt);

    });

  output.scrollIntoView({

    behavior: "smooth",

    block: "nearest"

  });
}


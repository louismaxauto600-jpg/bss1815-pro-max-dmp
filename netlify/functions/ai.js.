/* =========================================================
   LANGUAGE MANAGEMENT
   ========================================================= */

function initializeAILanguageUpdates() {

  document.addEventListener(

    "proMaxLanguageChanged",

    () => {

      renderAIToolCards();

      updateAIProjectDisplay();

      displayAIHistory();

      updateAIPromptPlaceholder();

    }
  );
}

function normalizeAILanguage(language) {

  const value = String(
    language || "ht"
  ).trim().toLowerCase();

  const languages = {

    ht: "ht",

    kre: "ht",

    kreyol: "ht",

    "ht-ht": "ht",

    fr: "fr",

    fra: "fr",

    fran: "fr",

    "fr-fr": "fr",

    en: "en",

    eng: "en",

    "en-us": "en",

    "en-gb": "en"

  };

  return Object.hasOwn(languages, value)

    ? languages[value]

    : "ht";
}

function getAILanguage() {

  if (
    typeof window.getCurrentLanguage === "function"
  ) {

    return normalizeAILanguage(
      window.getCurrentLanguage()
    );

  }

  return normalizeAILanguage(

    localStorage.getItem("proMaxLanguage") ||

    document.documentElement.lang ||

    "ht"

  );
}

function getAIText(
  creoleText,
  frenchText,
  englishText
) {

  const language = getAILanguage();

  if (language === "fr") {
    return frenchText;
  }

  if (language === "en") {
    return englishText;
  }

  return creoleText;
}

function getAILocalizedValue(value) {

  if (typeof value === "string") {
    return value;
  }

  const language = getAILanguage();

  return (

    value?.[language] ||

    value?.ht ||

    value?.fr ||

    value?.en ||

    ""

  );
}

function updateAIPromptPlaceholder() {

  const promptInput = document.querySelector(
    "#ai-prompt, [name='prompt'], [data-ai-prompt]"
  );

  if (!promptInput) {
    return;
  }

  const tool = getAITool(activeAITool);

  const name = getAILocalizedValue(
    tool?.name || ""
  );

  promptInput.placeholder = getAIText(

    `Ekri sa ou bezwen ${name} fè...`,

    `Écrivez ce que vous souhaitez que ${name} fasse...`,

    `Write what you want ${name} to do...`

  );
}


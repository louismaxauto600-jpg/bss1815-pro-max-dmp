  renderAIToolCards();
  initializeAIProjectSelector();
  initializeAIForm();
  initializeAIActionButtons();
  initializeAIHistoryControls();
  initializeAILanguageUpdates();
  updateAIProjectDisplay();
  displayAIHistory();
  setAIStatus("idle");

  console.info(
    "BSS1815 PRO-MAX DMP CENTRAL AI CENTER",
    PRO_MAX_AI_CENTER.version
